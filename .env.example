# Copy this file to .env and fill in your real key.
# The real .env is gitignored and must never be committed.

# Your Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used to generate grounded answers (optional; this is the default).
ANTHROPIC_MODEL=claude-sonnet-4-5

# Number of chunks to retrieve per question (optional; default 4).
TOP_K=4

# Minimum similarity for a chunk to count as "relevant." Chunks below this are
# ignored, which is what makes the honest-empty-case fire. (optional; default 0.25)
MIN_SCORE=0.25
